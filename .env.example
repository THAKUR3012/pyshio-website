# Copy this file to .env on the server and fill in your values.
# Never share .env or upload it anywhere public: it holds passwords and payment keys.

# --- Platform ---
PYSHIO_PLATFORM_NAME=Pyshio
# Your live address. Used in email links. Use https:// once SSL is on (login cookies become secure-only).
PYSHIO_SITE_URL=https://www.yourdomain.com
# All booking times use this timezone (GoDaddy servers run on US time)
PYSHIO_TIMEZONE=Asia/Kolkata

# --- Nearby network ---
# Doctors, pharmacies and prescriptions are matched within this distance of the patient's home
PYSHIO_RADIUS_KM=3
# Platform fee (%) kept from online payments before settling with doctors and pharmacies
PYSHIO_COMMISSION_PERCENT=0
# Doctor types allowed to write medicine prescriptions. Default: all. Indian law limits allopathic
# prescribing to registered medical practitioners; get legal advice, then e.g.:
# PYSHIO_PRESCRIBING_CATEGORIES=general_physician,specialist,dentist

# Pharmacies are reminded about an unaccepted order after REMIND minutes; it's auto-rejected (and refunded) after ACCEPT
PYSHIO_ORDER_REMIND_MINUTES=10
PYSHIO_ORDER_ACCEPT_MINUTES=30
# Shown on the website footer and privacy policy (grievance contact)
PYSHIO_SUPPORT_EMAIL=support@yourdomain.com
PYSHIO_SUPPORT_PHONE=
# Where lab reports and patients' uploaded files are kept (private; back it up with the database)
# PYSHIO_UPLOAD_DIR=/home/<username>/pyshio/uploads

# --- First admin account (created automatically on first start) ---
PYSHIO_ADMIN_EMAIL=admin@yourdomain.com
PYSHIO_ADMIN_PASSWORD=change-me-to-a-long-password

# --- Online payments (Razorpay). Leave blank to offer only "pay at clinic". ---
# Razorpay Dashboard > Account & Settings > API Keys. Use rzp_test_ keys first, then live keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard > Webhooks: URL https://www.yourdomain.com/api/payments/webhook,
# events payment.captured + order.paid, and the secret you type there goes here:
RAZORPAY_WEBHOOK_SECRET=
# Patients get a full refund if they cancel at least this many hours before
PYSHIO_REFUND_CUTOFF_HOURS=24

# --- Email (SMTP) ---
# GoDaddy cPanel email account (create it in cPanel > Email Accounts first):
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_USER=bookings@yourdomain.com
SMTP_PASSWORD=your-email-account-password
SMTP_FROM=bookings@yourdomain.com
# SMTP_SECURITY is worked out from the port (465=ssl, 587=starttls, other=none); override if needed:
# SMTP_SECURITY=ssl

# Optional: Claude for the AI features. Without a key every feature still works with built-in rules:
#   assistant    free-form answers in the in-app assistant (the user's own data only)
#   rx_read      reading uploaded prescription photos (only when the patient ticks the consent box)
#   scribe       drafting a prescription from the doctor's notes
#   lab_read     reading values from a lab report file for the lab to confirm
#   lab_explain  rewriting the plain-language report explanation for patients
#   triage       choosing the right speciality from symptoms (emergency signs are always rule-based)
#   mr_brief     short visit briefs for medical reps
# With a key, the minimum data each feature needs is sent to Anthropic (names, phones, emails and IDs are removed
# from text first). Review this under the DPDP Act and mention it in the privacy policy before switching it on.
# ANTHROPIC_API_KEY=
# PYSHIO_AI_MODEL=claude-sonnet-5-5           # default model for every AI feature
# PYSHIO_AI_MODEL_RX_READ=claude-sonnet-5-5   # per feature: PYSHIO_AI_MODEL_<FEATURE>
# PYSHIO_AI_RX_READ=0                         # switch one feature off: PYSHIO_AI_<FEATURE>=0
# PYSHIO_AI_DISABLED=1                        # switch every AI call off at once
# PYSHIO_ASSISTANT_MODEL=claude-sonnet-5-5    # older name for the assistant's model, still honoured

# Video consultations open in a Jitsi Meet room. Leave as is, or point at your own Jitsi server.
# PYSHIO_VIDEO_BASE_URL=https://meet.jit.si
# Sign-ups allowed per network (IP address) per hour
# PYSHIO_REGISTRATIONS_PER_HOUR=10
